# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Library files only change when a dependency is upgraded, but their URLs
# aren't versioned, so cache for a day rather than forever.
/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
